% Beamertheme admini — a dark, YouTube-native deck with a subtle defence-brief
% frame. Colour, font, outer and inner themes are split out so each can be
% iterated on independently.
\ProvidesPackage{beamerthemeadmini}

\mode<presentation>

\usecolortheme{admini}
\usefonttheme{admini}
\useoutertheme{admini}
\useinnertheme{admini}

\mode<all>

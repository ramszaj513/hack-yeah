# Copy to .env and fill in. .env is gitignored and must never be committed.

# Return the canned fixture instead of running a real check.
DEMO_MODE=false
FRONTEND_ORIGINS=*

# Required. Without it the API reports failure rather than pretending to check.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_MODEL=gpt-5.4

# Optional. Google Fact Check Tools covers claims a fact-checker already
# reviewed; the pipeline works without it, just with one less source.
GOOGLE_FACT_CHECK_API_KEY=

# Optional. Semantic Scholar rate-limits anonymous callers hard; a free key
# raises the limit. Europe PMC and OpenAlex cover for it when it is absent.
SEMANTIC_SCHOLAR_API_KEY=

MAX_CLAIMS=16
MAX_TRANSCRIPT_SEGMENTS=2000

ENABLE_WEB_SEARCH=true
ENABLE_CITATION_VERIFICATION=true
ENABLE_REFUTATION_PASS=true

# Sent in the User-Agent to OpenAlex/Crossref-style APIs for friendlier limits.
CONTACT_EMAIL=

# 0 keeps repeated checks of the same video consistent.
OPENAI_TEMPERATURE=0

# Rhetorical signals (manipulation, undisclosed ads, framing).
MAX_SIGNALS=10

# Opt-in result cache. Leave false for real use; turn on before a demo and
# run the check once to warm it, so it replays instantly and identically.
CACHE_ENABLED=false
CACHE_TTL_HOURS=72
CACHE_PATH=.cache/pipeline.sqlite3
